# Normalize line endings for text files; keep binaries (wasm, images) untouched.
* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf

*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.stl binary
*.stp binary
